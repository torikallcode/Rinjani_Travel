# Environment backend

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=rinjani_travel_db
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Server
SERVER_PORT=8000
SERVER_ENV=development
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60

# Autentikasi
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRY=168h

# Pembayaran
PAYMENT_PROVIDER=mock
PAYMENT_GATEWAY_SECRET=change-this-webhook-secret
TAX_PERCENT=0
BOOKING_HOLD_MINUTES=30

# Email transaksional (opsional di development)
EMAIL_FROM=noreply@rinjanitravel.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# Identitas bisnis
BUSINESS_NAME=Rinjani Travel
BUSINESS_EMAIL=hello@rinjanitravel.com
BUSINESS_PHONE=+62 812-3456-7890
BUSINESS_ADDRESS=Jl. Raya Sembalun, Lombok Timur, Nusa Tenggara Barat
WHATSAPP_PHONE_NUMBER=6281234567890
